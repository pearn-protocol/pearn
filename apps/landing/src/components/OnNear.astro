---
import { stack } from "../data/content";
import { site } from "../data/site";
import Section from "./ui/Section.astro";
---

<Section id="near" tone="dark" eyebrow="Built on NEAR" title={["The yield and", "the rate, both", "from NEAR."]}>
	<Fragment slot="lead">
		No off-chain price feed. A Solidity contract on Aurora asks Meta Pool on NEAR what one stNEAR
		is worth, and the answer comes back in a callback.
	</Fragment>
	<div class="grid">
		{
			stack.map((s, i) => (
				<div class="cell">
					<span class="label n">[ 0{i + 1} ]</span>
					<h3>{s.title}</h3>
					<p>{s.text}</p>
				</div>
			))
		}
	</div>
	<ul class="links">
		<li><a href={site.explorerUrl}>PearnMarkets on Blockscout →</a></li>
		<li><a href={`${site.docsUrl}/docs/oracle/`}>How the oracle works →</a></li>
		<li><a href={`${site.docsUrl}/docs/without-aurora-eth/`}>Deploying without Aurora ETH →</a></li>
	</ul>
</Section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}
	.cell {
		padding: 24px;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.n {
		color: var(--glyph);
	}
	h3 {
		margin: 16px 0 8px;
		font-size: 20px;
	}
	p {
		color: var(--muted);
	}
	@media (max-width: 600px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 32px;
		margin-top: 32px;
	}
	.links a {
		color: var(--accent);
		text-decoration: none;
	}
	.links a:hover {
		text-decoration: underline;
	}
</style>
