---
/** The newest markets, fetched from the indexer in the browser. Without it: a link to the app. */
import { site } from "../data/site";
import Section from "./ui/Section.astro";
---

<Section id="markets" tone="dark" eyebrow="Live on Aurora testnet" title={["Live", "markets."]}>
	<Fragment slot="lead">
		The newest markets, read from the Pearn indexer as you open this page, most of them mirrored
		from Polymarket and resolved as Polymarket settles them. Testnet stNEAR, real
		contracts.
	</Fragment>
	<div class="cards" data-markets data-indexer={site.indexerUrl} data-app={site.appUrl}>
		<p class="empty">
			<span class="msg">Loading markets… If they do not show,</span>
			<a href={site.appUrl}>open the app</a>.
		</p>
	</div>
	<template id="market-card">
		<a class="market">
			<span class="top"><img alt="" class="glyph" height="32" width="32" /><span class="topic"></span><span class="status"></span></span>
			<h3></h3>
			<div class="bar" aria-hidden="true"><span></span></div>
			<p class="meta"></p>
		</a>
	</template>
</Section>

<script>
	import { fetchCards } from "../scripts/markets";

	const root = document.querySelector<HTMLElement>("[data-markets]");
	const tpl = document.querySelector<HTMLTemplateElement>("#market-card");
	if (root && tpl) {
		const { indexer = "", app = "" } = root.dataset;
		fetchCards(indexer)
			.then((cards) => {
				if (!cards.length) return;
				root.replaceChildren(
					...cards.map((c) => {
						const node = tpl.content.cloneNode(true) as DocumentFragment;
						const a = node.querySelector("a") as HTMLAnchorElement;
						a.href = `${app}/market/?id=${c.id}`;
						(node.querySelector(".status") as HTMLElement).textContent = `■ ${c.status}`;
						(node.querySelector(".topic") as HTMLElement).textContent = c.topic;
						const img = node.querySelector(".glyph") as HTMLImageElement;
						if (c.image) img.src = c.image;
						else img.replaceWith(Object.assign(document.createElement("span"), { className: "glyph", textContent: "P" }));
						(node.querySelector("h3") as HTMLElement).textContent = c.question;
						const bar = node.querySelector(".bar span") as HTMLElement;
						const pct = c.chance ?? c.yes;
						bar.style.width = `${pct ?? 0}%`;
						const odds =
							c.chance !== null
								? `${c.chance}% chance on Polymarket`
								: c.yes === null
									? "No bets yet"
									: `${c.yes}% YES`;
						(node.querySelector(".meta") as HTMLElement).textContent =
							`${odds} · ${c.staked} stNEAR${c.usd ? ` (≈ ${c.usd})` : ""} · ${c.bets} bet${c.bets === 1 ? "" : "s"}`;
						return node;
					}),
				);
			})
			.catch(() => {
				root.querySelector(".msg")?.replaceChildren("The indexer is not answering right now;");
			});
	}
</script>

<style>
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 16px;
	}
	.empty {
		grid-column: 1 / -1;
		color: var(--muted);
	}
	.cards :global(.market) {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-height: 220px;
		padding: 24px;
		border: 1px solid var(--line);
		background: var(--surface);
		text-decoration: none;
		transition: border-color 250ms ease;
	}
	.cards :global(.market:hover) {
		border-color: var(--accent);
	}
	.cards :global(.top) {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.cards :global(.glyph) {
		display: inline-grid;
		flex: none;
		place-items: center;
		width: 32px;
		height: 32px;
		object-fit: cover;
		background: var(--accent);
		color: var(--on-accent);
		font-size: 15px;
	}
	.cards :global(.topic) {
		color: var(--muted);
	}
	.cards :global(.status) {
		margin-left: auto;
		color: var(--accent);
	}
	.cards :global(h3) {
		font-size: 18px;
	}
	.cards :global(.bar) {
		height: 8px;
		margin-top: auto;
		background: var(--panel);
	}
	.cards :global(.bar span) {
		display: block;
		height: 100%;
		background: var(--accent);
	}
	.cards :global(.meta) {
		color: var(--muted);
		font-size: 12px;
	}
</style>
