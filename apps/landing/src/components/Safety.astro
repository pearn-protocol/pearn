---
import { safety } from "../data/content";
import { site } from "../data/site";
import Section from "./ui/Section.astro";
---

<Section id="safety" tone="accent" eyebrow="Safety / threat model" title={["Small surface.", "No owner."]}>
	<Fragment slot="lead">
		No admin, no upgrades. The only special role is a guardian that can mark an outcome Invalid,
		and only for a day. <a href={`${site.docsUrl}/docs/risks/`}>Risks, in full →</a>
	</Fragment>
	<dl class="rows">
		{
			safety.map((s) => (
				<div>
					<dt>{s.title}</dt>
					<dd>{s.text}</dd>
				</div>
			))
		}
	</dl>
</Section>

<style>
	.rows div {
		display: grid;
		grid-template-columns: 2fr 3fr;
		gap: 24px;
		padding: 22px 0;
		border-bottom: 1px solid var(--rule);
	}
	.rows div:first-child {
		border-top: 1px solid var(--rule);
	}
	dt {
		font-size: 20px;
		letter-spacing: -0.04em;
	}
	dd {
		color: var(--on-light-muted);
	}
	@media (max-width: 600px) {
		.rows div {
			grid-template-columns: 1fr;
			gap: 6px;
		}
	}
</style>
