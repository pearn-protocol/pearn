---
/** Native exclusive `<details name>` rows: one answer open at a time, no script. */
import { faq } from "../data/content";
import Section from "./ui/Section.astro";
---

<Section id="faq" tone="paper" eyebrow="FAQ" title={["Common", "questions."]}>
	<Fragment slot="lead">Anything else is in the docs.</Fragment>
	<div>
		{
			faq.map((item) => (
				<details name="faq">
					<summary>
						<h3>{item.q}</h3>
						<span aria-hidden="true">+</span>
					</summary>
					<p>{item.a}</p>
				</details>
			))
		}
	</div>
</Section>

<style>
	details {
		border-bottom: 1px solid var(--rule-on-light);
	}
	details:first-child {
		border-top: 1px solid var(--rule-on-light);
	}
	summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		padding: 24px 0;
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	h3 {
		font-size: 20px;
	}
	summary span {
		font-size: 24px;
		line-height: 1;
		transition: transform 300ms var(--ease);
	}
	details[open] summary span {
		transform: rotate(45deg);
	}
	details p {
		color: var(--on-light-muted);
		padding-bottom: 24px;
		max-width: 640px;
	}
</style>
