---
/** Logo left, a Menu panel in the middle that opens the menu dialog, the CTA on the right. */
import { nav, site } from "../data/site";
import Cta from "./ui/Cta.astro";
---

<header class="header">
	<a class="logo" href="/" aria-label="Pearn home">
		<img src="/favicon-32x32.png" alt="" width="32" height="32" />
		<span>Pearn</span>
	</a>
	<button class="menu-button" type="button" data-menu-open aria-haspopup="dialog">
		<span>Menu</span>
		<span class="bars" aria-hidden="true"></span>
	</button>
	<Cta href={site.appUrl} label="Open the app" />
</header>

<dialog class="menu" data-menu aria-label="Menu">
	<div class="menu-top">
		<span class="label">Pearn / Aurora testnet</span>
		<button type="button" data-menu-close aria-label="Close menu">×</button>
	</div>
	<nav aria-label="Sections">
		{nav.map((l, i) => <a href={l.href}><span class="n">0{i + 1}</span>{l.label}</a>)}
		<a href={site.docsUrl}><span class="n">0{nav.length + 1}</span>Docs</a>
		<a href={site.repoUrl}><span class="n">0{nav.length + 2}</span>GitHub</a>
	</nav>
	<p class="menu-info">
		The no-loss prediction market on NEAR. Win or lose, your stake comes back; winners split the
		staking yield.
	</p>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>("[data-menu]");
	document.querySelector("[data-menu-open]")?.addEventListener("click", () => dialog?.showModal());
	document.querySelector("[data-menu-close]")?.addEventListener("click", () => dialog?.close());
	// Following a section link closes the menu; a click on the backdrop does too.
	dialog?.addEventListener("click", (e) => {
		if (e.target === dialog || (e.target as Element).closest("a")) dialog.close();
	});
</script>

<style>
	.header {
		position: absolute;
		inset: 0 0 auto;
		z-index: 10;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 24px;
		max-width: var(--max);
		margin: 0 auto;
		padding: 48px var(--gutter) 0;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--accent);
		font-size: 22px;
		text-decoration: none;
	}
	.menu-button {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 320px;
		height: var(--control-h);
		padding: 0 16px;
		border: 0;
		background: var(--panel);
		color: var(--ink);
		font: inherit;
		cursor: pointer;
	}
	.bars,
	.bars::before {
		display: block;
		width: 32px;
		height: 2px;
		background: currentColor;
	}
	.bars {
		position: relative;
		top: -4px;
	}
	.bars::before {
		content: "";
		position: absolute;
		top: 8px;
	}
	.header :global(.cta) {
		justify-self: end;
	}
	.menu {
		width: min(560px, calc(100% - 2 * var(--gutter)));
		max-width: none;
		max-height: none;
		margin: 48px auto auto;
		padding: 24px;
		border: 0;
		background: var(--panel);
		color: var(--ink);
	}
	.menu::backdrop {
		background: rgb(0 0 0 / 0.7);
	}
	.menu-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		color: var(--muted);
	}
	.menu-top button {
		border: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		font-size: 24px;
		line-height: 1;
		cursor: pointer;
	}
	.menu nav {
		display: grid;
		margin: 24px 0;
	}
	.menu nav a {
		display: flex;
		gap: 16px;
		padding: 14px 0;
		border-bottom: 1px solid var(--line);
		font-size: 22px;
		letter-spacing: -0.04em;
		text-decoration: none;
	}
	.menu nav a:hover {
		color: var(--accent);
	}
	.n {
		color: var(--glyph);
		font-size: 12px;
		letter-spacing: 0;
		padding-top: 8px;
	}
	.menu-info {
		color: var(--muted);
	}
	@media (max-width: 900px) {
		.header {
			grid-template-columns: auto 1fr;
			padding-top: 20px;
		}
		.menu-button {
			width: auto;
			justify-self: end;
			gap: 16px;
		}
		.menu-button span:first-child {
			display: none;
		}
		.header :global(.cta) {
			display: none;
		}
		.menu {
			margin-top: 20px;
		}
	}
</style>
