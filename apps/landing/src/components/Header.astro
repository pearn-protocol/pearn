---
import { nav, site } from "../data/site";
---

<header>
	<div class="wrap bar">
		<a class="logo" href="/" aria-label="Pearn home">
			<img src="/favicon-32x32.png" alt="" width="28" height="28" />
			<span>Pearn</span>
		</a>
		<nav aria-label="Sections">
			{nav.map((l) => <a href={l.href}>{l.label}</a>)}
			<a href={site.docsUrl}>Docs</a>
		</nav>
		<a class="button primary" href={site.appUrl}>Open the app</a>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 24px;
		height: 64px;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 700;
		font-size: 19px;
		text-decoration: none;
	}
	.logo img {
		border-radius: 8px;
	}
	nav {
		display: flex;
		gap: 20px;
		margin-left: auto;
		font-size: 15px;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--ink);
	}
	.button {
		padding: 8px 16px;
		font-size: 15px;
	}
	@media (max-width: 820px) {
		nav {
			display: none;
		}
		.button {
			margin-left: auto;
		}
	}
</style>
