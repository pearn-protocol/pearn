---
import { steps } from "../data/content";
import Section from "./ui/Section.astro";
---

<Section id="how" tone="accent" eyebrow="How it works / no-loss" title={["Bet the interest.", "Keep the money."]}>
	<Fragment slot="lead">
		In a normal prediction market the loser loses everything. On Pearn you only put the staking
		yield on the line.
	</Fragment>
	<ol class="steps">
		{
			steps.map((s, i) => (
				<li>
					<span class="n">0{i + 1}</span>
					<div>
						<h3>{s.title}</h3>
						<p>{s.text}</p>
					</div>
				</li>
			))
		}
	</ol>
</Section>

<style>
	.steps li {
		display: grid;
		grid-template-columns: 56px 1fr;
		padding: 28px 0;
		border-bottom: 1px solid var(--rule);
	}
	.steps li:first-child {
		border-top: 1px solid var(--rule);
	}
	.n {
		font-size: 12px;
		padding-top: 6px;
	}
	h3 {
		font-size: 22px;
		margin-bottom: 8px;
	}
	p {
		color: var(--on-light-muted);
		max-width: 560px;
	}
</style>
