---
import Header from "../components/Header.astro";
import Cta from "../components/ui/Cta.astro";
import { site } from "../data/site";
import Base from "../layouts/Base.astro";
---

<Base title="Not found | Pearn">
	<Header />
	<main class="missing">
		<p class="label">Error 404</p>
		<h1><span>Nothing here.</span></h1>
		<p>Looking for a market? Markets live in the app.</p>
		<Cta href={site.appUrl} label="Open the app" />
	</main>
</Base>

<style>
	.missing {
		display: grid;
		justify-items: center;
		align-content: center;
		gap: 20px;
		min-height: 100svh;
		padding: 140px var(--gutter);
		text-align: center;
		color: var(--muted);
	}
	h1 {
		font-size: 32px;
		color: var(--on-accent);
	}
	h1 span {
		padding: 2px 10px;
		background: var(--accent);
	}
</style>
